<script>
/* theme (set early to avoid flash) + shared image fallback */
(function(){var t;try{t=localStorage.getItem('theme')}catch(e){}
if(!t)t=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
document.documentElement.dataset.theme=t})();
var PH='data:image/svg+xml,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8B263E"/><stop offset="1" stop-color="#D4AF37"/></linearGradient></defs><rect width="400" height="300" fill="url(#g)"/><path d="M150 230V150a50 50 0 0 1 100 0v80z" fill="none" stroke="#FAF7F2" stroke-width="5" opacity=".8"/></svg>');
