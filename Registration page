<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Explore Gwalior: Heritage Walk 2026 - Registration</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Roboto -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            heritage: {
              50: '#fdf8f6',
              100: '#f2e8e5',
              200: '#eaddd7',
              500: '#b45309', // Terracotta warm amber
              600: '#9a3412', // Warm terracotta red
              700: '#7c2d12',
              800: '#431407',
            },
            formbg: '#f0ebf8',
          },
          fontFamily: {
            sans: ['Roboto', 'Inter', 'sans-serif'],
            serif: ['Cinzel', 'serif'],
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #f6f1eb;
      font-family: 'Roboto', 'Inter', sans-serif;
    }
    .active-card {
      border-left: 6px solid #9a3412;
    }
    .input-field:focus ~ .input-border {
      width: 100%;
    }
    .input-border {
      transition: width 0.25s ease-in-out;
    }
    /* Custom radio and checkbox styling */
    .custom-radio:checked {
      border-color: #9a3412;
      background-color: #9a3412;
      box-shadow: inset 0 0 0 3px white;
    }
    .custom-checkbox:checked {
      background-color: #9a3412;
      border-color: #9a3412;
    }
    @media print {
      body {
        background-color: white;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen text-gray-800 antialiased pb-16">

  <!-- Top Progress Bar -->
  <div class="fixed top-0 left-0 w-full h-1.5 bg-stone-200 z-50">
    <div id="topProgressBar" class="h-full bg-heritage-600 transition-all duration-300 ease-out" style="width: 25%;"></div>
  </div>

  <!-- Header Banner & Decorative Branding -->
  <div class="max-w-3xl mx-auto pt-6 px-3 sm:px-4">
    <!-- Top Visual Banner Card -->
    <div class="w-full bg-gradient-to-r from-stone-900 via-heritage-800 to-heritage-700 rounded-t-2xl overflow-hidden shadow-sm relative h-48 sm:h-56 flex flex-col justify-end p-6 text-white border-b-4 border-amber-500">
      <div class="absolute inset-0 opacity-25 mix-blend-overlay pointer-events-none" style="background-image: radial-gradient(#fbbf24 1px, transparent 1px); background-size: 18px 18px;"></div>
      <div class="absolute top-4 right-4 bg-amber-500/20 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold tracking-wider text-amber-200 uppercase flex items-center gap-1.5 border border-amber-400/30">
        <i data-lucide="compass" class="w-3.5 h-3.5"></i> Heritage &amp; Tourism Club
      </div>
      <div class="relative z-10">
        <span class="text-amber-300 text-xs sm:text-sm font-semibold tracking-widest uppercase">Annual Archaeological Expedition</span>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold font-serif tracking-tight mt-1 text-white">Explore Gwalior: Heritage Walk 2026</h1>
        <p class="text-stone-200 text-xs sm:text-sm mt-1 flex flex-wrap items-center gap-3">
          <span class="flex items-center gap-1"><i data-lucide="calendar" class="w-3.5 h-3.5 text-amber-400"></i> Sunday, Nov 15, 2026</span>
          <span class="flex items-center gap-1"><i data-lucide="clock" class="w-3.5 h-3.5 text-amber-400"></i> 06:30 AM IST</span>
          <span class="flex items-center gap-1"><i data-lucide="map-pin" class="w-3.5 h-3.5 text-amber-400"></i> Urvai Gate, Gwalior Fort</span>
        </p>
      </div>
    </div>

    <!-- Title Card & Guidelines -->
    <div class="bg-white rounded-b-2xl shadow-sm border border-t-0 border-stone-200 p-6 sm:p-8 mb-4 active-card">
      <div class="flex items-center justify-between border-b pb-4 border-stone-200">
        <div>
          <h2 class="text-lg font-bold text-stone-900">Official Participant Registration</h2>
          <p class="text-xs text-stone-500 mt-0.5">Organized by Heritage &amp; Tourism Club • Gwalior Chapter</p>
        </div>
        <span class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full border border-emerald-200 flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Registrations Open
        </span>
      </div>

      <div class="mt-4 text-xs sm:text-sm text-stone-600 leading-relaxed space-y-2">
        <p>Explore centuries of majestic architecture across the legendary <strong>Gwalior Fort, Man Singh Palace, Teli Ka Mandir, Saas-Bahu Temples</strong>, and the mausoleum of <strong>Miyan Tansen</strong> led by veteran historians and architectural preservationists.</p>
        <p class="text-xs text-amber-800 bg-amber-50 p-2.5 rounded-lg border border-amber-200/80 flex items-start gap-2">
          <i data-lucide="info" class="w-4 h-4 text-amber-600 shrink-0 mt-0.5"></i>
          <span>Distance: <strong>~4.5 km walking trail</strong> with stone stairways. Light refreshments, heritage booklet, and verified e-certificates will be provided to all registered participants.</span>
        </p>
      </div>

      <!-- Account / Required alert strip -->
      <div class="mt-5 pt-3 border-t border-stone-100 flex flex-wrap items-center justify-between text-xs text-stone-500">
        <div class="flex items-center gap-1.5 text-stone-600">
          <i data-lucide="user-check" class="w-4 h-4 text-stone-400"></i>
          <span>Form collects responses for logistical and safety clearance.</span>
        </div>
        <div class="text-red-600 font-medium">* Indicates required question</div>
      </div>
    </div>

    <!-- MAIN FORM CONTAINER -->
    <form id="heritageForm" novalidate onsubmit="return false;">

      <!-- SECTION 1: Personal & Contact Information -->
      <div id="section-1" class="form-section space-y-4">
        <!-- Section Header Indicator -->
        <div class="bg-heritage-100/60 border border-heritage-200/80 rounded-xl px-5 py-3 text-heritage-800 flex items-center justify-between text-xs font-semibold">
          <span>SECTION 1 OF 4 &bull; PARTICIPANT IDENTIFICATION</span>
          <span class="text-stone-500">Contact &amp; Emergency</span>
        </div>

        <!-- Full Name Card -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-fullName">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="fullName">
            Participant Full Name <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">As it should appear on your Heritage Walk Certificate.</p>
          <div class="relative">
            <input type="text" id="fullName" name="fullName" required placeholder="Your answer"
              class="w-full text-sm sm:text-base py-2.5 px-0 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 transition-colors" />
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please enter your full name.</span>
          </p>
        </div>

        <!-- Email Card -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-email">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="email">
            Email Address <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">Event guide, route map, and confirmation ticket will be sent here.</p>
          <div class="relative">
            <input type="email" id="email" name="email" required placeholder="name@domain.com"
              class="w-full text-sm sm:text-base py-2.5 px-0 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 transition-colors" />
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please enter a valid email address (e.g., student@college.edu).</span>
          </p>
        </div>

        <!-- WhatsApp / Contact Number Card -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-phone">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="phone">
            WhatsApp / Primary Mobile Number <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">Used for real-time coordinator coordination on event morning.</p>
          <div class="relative">
            <div class="flex items-center">
              <span class="text-stone-500 text-sm font-medium mr-2 border-b-2 border-stone-300 pb-2.5">+91</span>
              <input type="tel" id="phone" name="phone" maxlength="10" placeholder="10-digit mobile number"
                class="w-full text-sm sm:text-base py-2.5 px-0 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 transition-colors" />
            </div>
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please provide a valid 10-digit Indian mobile number.</span>
          </p>
        </div>

        <!-- Emergency Contact -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-emergency">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="emergencyContact">
            Emergency Contact Person &amp; Phone <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">Parent / Guardian / Local Warden (Name - 10-digit Number)</p>
          <div class="relative">
            <input type="text" id="emergencyContact" name="emergencyContact" placeholder="e.g. Rajesh Sharma (Father) - 9826012345"
              class="w-full text-sm sm:text-base py-2.5 px-0 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 transition-colors" />
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Emergency contact information is mandatory for field safety.</span>
          </p>
        </div>
      </div>

      <!-- SECTION 2: Academic & Institutional Information -->
      <div id="section-2" class="form-section space-y-4 hidden">
        <div class="bg-heritage-100/60 border border-heritage-200/80 rounded-xl px-5 py-3 text-heritage-800 flex items-center justify-between text-xs font-semibold">
          <span>SECTION 2 OF 4 &bull; ACADEMIC &amp; AFFILIATION DETAILS</span>
          <span class="text-stone-500">Institution &amp; Batch</span>
        </div>

        <!-- College / Institute Name -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-college">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="college">
            College / Institute / University Name <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">Select your institute or enter details if not listed.</p>
          <div class="relative">
            <select id="college" name="college" class="w-full text-sm sm:text-base py-2.5 px-2 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 cursor-pointer">
              <option value="">-- Choose Institute --</option>
              <option value="MITS Gwalior">Madhav Institute of Technology &amp; Science (MITS)</option>
              <option value="ABV-IIITM Gwalior">ABV - Indian Institute of Information Technology &amp; Management</option>
              <option value="ITM University Gwalior">ITM University / ITM GOI</option>
              <option value="Jiwaji University">Jiwaji University, Gwalior</option>
              <option value="Amity University Gwalior">Amity University, Madhya Pradesh</option>
              <option value="LNIPE Gwalior">Lakshmibai National Institute of Physical Education (LNIPE)</option>
              <option value="Scindia Kanya Vidyalaya / The Scindia School">The Scindia School / SKV</option>
              <option value="Other">Other Independent Institution / Walk Enthusiast</option>
            </select>
          </div>
          <div id="otherCollegeBox" class="mt-3 hidden">
            <input type="text" id="otherCollegeName" placeholder="Enter full institution name"
              class="w-full text-sm py-2 px-0 border-0 border-b border-stone-300 focus:outline-none focus:border-heritage-600 bg-transparent" />
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please select or specify your college/institute.</span>
          </p>
        </div>

        <!-- Branch / Course -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-branch">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="branch">
            Branch / Department / Course of Study <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">e.g., Architecture, Civil Engg, History, Computer Science, Tourism Management</p>
          <div class="relative">
            <input type="text" id="branch" name="branch" placeholder="Your answer"
              class="w-full text-sm sm:text-base py-2.5 px-0 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 transition-colors" />
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please mention your branch/course.</span>
          </p>
        </div>

        <!-- Year / Semester -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-year">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="yearSemester">
            Year / Current Semester <span class="text-red-500">*</span>
          </label>
          <div class="relative mt-2">
            <select id="yearSemester" name="yearSemester" class="w-full text-sm sm:text-base py-2.5 px-2 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 cursor-pointer">
              <option value="">-- Select Year / Status --</option>
              <option value="1st Year (Sem 1-2)">1st Year (Semester 1 or 2)</option>
              <option value="2nd Year (Sem 3-4)">2nd Year (Semester 3 or 4)</option>
              <option value="3rd Year (Sem 5-6)">3rd Year (Semester 5 or 6)</option>
              <option value="4th Year (Sem 7-8)">4th Year (Semester 7 or 8)</option>
              <option value="Post-Graduate / M.Tech / MBA / Ph.D">Post-Graduate / Research Scholar</option>
              <option value="Faculty / Alumni / Professional">Faculty / Staff / Alumni</option>
            </select>
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please select your year or academic standing.</span>
          </p>
        </div>

        <!-- Student / Identity Roll No -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-roll">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="rollNumber">
            Enrollment / Student ID / Roll Number <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">Required for verification at the ASI monument checkpost.</p>
          <div class="relative">
            <input type="text" id="rollNumber" name="rollNumber" placeholder="e.g. 0901CS221045 or Employee ID"
              class="w-full text-sm sm:text-base py-2.5 px-0 border-0 border-b-2 border-stone-300 bg-transparent focus:ring-0 focus:outline-none focus:border-heritage-600 transition-colors" />
          </div>
          <p class="error-msg text-xs text-red-600 mt-2 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>Please provide your valid ID/Roll Number.</span>
          </p>
        </div>
      </div>

      <!-- SECTION 3: Logistics, Health & Preferences -->
      <div id="section-3" class="form-section space-y-4 hidden">
        <div class="bg-heritage-100/60 border border-heritage-200/80 rounded-xl px-5 py-3 text-heritage-800 flex items-center justify-between text-xs font-semibold">
          <span>SECTION 3 OF 4 &bull; LOGISTICS &amp; HEALTH PREFERENCES</span>
          <span class="text-stone-500">Kits &amp; Readiness</span>
        </div>

        <!-- Commemorative T-Shirt / Badge Size -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1">
            Commemorative T-Shirt &amp; Volunteer Sash Size <span class="text-stone-400 text-xs font-normal">(Optional)</span>
          </label>
          <p class="text-xs text-stone-500 mb-4">Official club walk merchandise (Provided on first-come-first-serve basis).</p>
          <div class="space-y-3 text-sm">
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="tshirt" value="S (38)" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span>Small (S - 38")</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="tshirt" value="M (40)" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" checked />
              <span>Medium (M - 40")</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="tshirt" value="L (42)" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span>Large (L - 42")</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="tshirt" value="XL (44)" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span>Extra Large (XL - 44")</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="tshirt" value="Not Needed" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span>Not needed (Opt-out)</span>
            </label>
          </div>
        </div>

        <!-- Prior Heritage Walk Experience -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1">
            Have you participated in a Heritage Walk or Long Hike before?
          </label>
          <div class="mt-3 space-y-3 text-sm">
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="experience" value="Yes" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span>Yes, I am familiar with group historical trails</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer select-none">
              <input type="radio" name="experience" value="No" class="custom-radio w-4 h-4 text-heritage-600 focus:ring-heritage-500 border-stone-300" checked />
              <span>No, this will be my first heritage walking tour</span>
            </label>
          </div>
        </div>

        <!-- Medical Conditions / Dietary Needs -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1" for="medicalNotes">
            Medical Precautions / Physical Constraints / Dietary Restrictions <span class="text-stone-400 text-xs font-normal">(Optional)</span>
          </label>
          <p class="text-xs text-stone-500 mb-3">Please state any asthma, knee/ligament issues, heat sensitivity, or emergency allergies so our paramedic volunteers are informed.</p>
          <div class="relative">
            <textarea id="medicalNotes" name="medicalNotes" rows="3" placeholder="Write 'None' if not applicable..."
              class="w-full text-sm sm:text-base p-2 border border-stone-300 rounded-lg focus:ring-1 focus:ring-heritage-600 focus:border-heritage-600 focus:outline-none"></textarea>
          </div>
        </div>
      </div>

      <!-- SECTION 4: Code of Conduct & Undertaking -->
      <div id="section-4" class="form-section space-y-4 hidden">
        <div class="bg-heritage-100/60 border border-heritage-200/80 rounded-xl px-5 py-3 text-heritage-800 flex items-center justify-between text-xs font-semibold">
          <span>SECTION 4 OF 4 &bull; DECLARATION &amp; UNDERTAKING</span>
          <span class="text-stone-500">Compliance &amp; Submit</span>
        </div>

        <!-- Guidelines Card -->
        <div class="bg-amber-50 rounded-xl border border-amber-200 p-5 text-xs text-amber-900 space-y-2">
          <div class="font-bold flex items-center gap-1.5 text-amber-950 text-sm">
            <i data-lucide="shield-check" class="w-4 h-4 text-heritage-600"></i> Code of Honor &amp; Monument Protection
          </div>
          <p>The monuments of Gwalior are protected national treasures under the Archaeological Survey of India (ASI). Any scribbling, defacement, littering, or damage to structures is punishable by law.</p>
        </div>

        <!-- Required Checkboxes -->
        <div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 transition-all hover:border-stone-300 question-box" id="box-undertaking">
          <label class="block text-sm sm:text-base font-medium text-stone-800 mb-1">
            Participant Undertaking &amp; Consent <span class="text-red-500">*</span>
          </label>
          <p class="text-xs text-stone-500 mb-4">You must check all 3 boxes to confirm your registration.</p>

          <div class="space-y-3.5 text-xs sm:text-sm text-stone-700">
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input type="checkbox" id="ruleMonument" class="custom-checkbox mt-1 w-4 h-4 rounded text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span><strong>Zero Heritage Impact:</strong> I promise to not litter, leave single-use plastics, or deface any monument walls or sculptures during the walk.</span>
            </label>
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input type="checkbox" id="ruleFitness" class="custom-checkbox mt-1 w-4 h-4 rounded text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span><strong>Physical Fitness:</strong> I confirm I am physically fit to complete a ~4-5 km brisk walking tour with steep stone ramps and stairs.</span>
            </label>
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input type="checkbox" id="ruleMarshal" class="custom-checkbox mt-1 w-4 h-4 rounded text-heritage-600 focus:ring-heritage-500 border-stone-300" />
              <span><strong>Coordination Adherence:</strong> I will strictly follow time schedules, safety instructions, and route directions provided by walk marshals.</span>
            </label>
          </div>
          <p class="error-msg text-xs text-red-600 mt-3 hidden flex items-center gap-1">
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> <span>All three undertaking acknowledgments are mandatory to participate.</span>
          </p>
        </div>
      </div>

      <!-- Action & Navigation Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3 pt-2">
        <div class="flex items-center gap-3">
          <button type="button" id="prevBtn" class="hidden px-5 py-2.5 rounded-lg border border-stone-300 text-stone-700 font-medium text-sm hover:bg-stone-100 transition active:scale-95 flex items-center gap-1.5">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
          </button>
          <button type="button" id="nextBtn" class="px-7 py-2.5 rounded-lg bg-heritage-600 hover:bg-heritage-700 text-white font-medium text-sm shadow-md hover:shadow-lg transition active:scale-95 flex items-center gap-1.5">
            Next <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
          <button type="button" id="submitBtn" class="hidden px-8 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm shadow-md hover:shadow-lg transition active:scale-95 flex items-center gap-1.5">
            Submit Registration <i data-lucide="check" class="w-4 h-4"></i>
          </button>
        </div>

        <div class="flex items-center gap-4 text-xs text-stone-500">
          <span id="pageStepLabel">Page 1 of 4</span>
          <button type="button" id="clearFormBtn" class="text-stone-500 hover:text-red-600 transition underline underline-offset-2">
            Clear form
          </button>
        </div>
      </div>
    </form>

    <!-- SUCCESS / CONFIRMATION SCREEN (Shown on Submit) -->
    <div id="confirmationScreen" class="hidden space-y-5">
      <!-- Confirmation Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-stone-200 p-6 sm:p-8 active-card text-center sm:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-4 border-b border-stone-200 pb-6">
          <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
            <i data-lucide="badge-check" class="w-10 h-10"></i>
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-600 tracking-wider uppercase">Registration Confirmed</span>
            <h2 class="text-2xl font-bold text-stone-900">Explore Gwalior: Heritage Walk 2026</h2>
            <p class="text-xs sm:text-sm text-stone-500 mt-1">Your response has been recorded successfully. A confirmation slip has been generated below.</p>
          </div>
        </div>

        <!-- Registration Pass Ticket Box -->
        <div id="registrationTicket" class="mt-6 bg-stone-50 rounded-xl border border-stone-200 p-5 sm:p-6 text-left relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
            <i data-lucide="landmark" class="w-48 h-48 text-stone-800"></i>
          </div>
          <div class="flex flex-wrap items-center justify-between border-b border-dashed border-stone-300 pb-4 gap-2">
            <div>
              <span class="text-xs font-mono text-stone-400">REGISTRATION PASS ID</span>
              <p id="ticketId" class="text-lg font-bold font-mono text-heritage-700">GWL-HW26-XXXX</p>
            </div>
            <div class="text-right">
              <span class="text-xs font-mono text-stone-400">STATUS</span>
              <span class="inline-block px-2.5 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800">VERIFIED ENTRY</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4 text-xs sm:text-sm">
            <div>
              <span class="text-stone-400 text-xs block">PARTICIPANT NAME</span>
              <span id="ticketName" class="font-semibold text-stone-800 text-base">-</span>
            </div>
            <div>
              <span class="text-stone-400 text-xs block">EMAIL ADDRESS</span>
              <span id="ticketEmail" class="font-semibold text-stone-800">-</span>
            </div>
            <div>
              <span class="text-stone-400 text-xs block">COLLEGE / INSTITUTE</span>
              <span id="ticketCollege" class="font-semibold text-stone-800">-</span>
            </div>
            <div>
              <span class="text-stone-400 text-xs block">CONTACT NUMBER</span>
              <span id="ticketPhone" class="font-semibold text-stone-800">-</span>
            </div>
            <div>
              <span class="text-stone-400 text-xs block">ASSEMBLY SPOT &amp; TIME</span>
              <span class="font-semibold text-stone-800">Urvai Gate &bull; 06:30 AM (15 Nov 2026)</span>
            </div>
            <div>
              <span class="text-stone-400 text-xs block">T-SHIRT KIT SIZE</span>
              <span id="ticketSize" class="font-semibold text-stone-800">Medium (M)</span>
            </div>
          </div>

          <div class="border-t border-dashed border-stone-300 pt-3 flex flex-wrap items-center justify-between text-xs text-stone-500 gap-2">
            <span>Bring a valid Student / Government ID card along with this pass.</span>
            <span class="font-medium text-stone-700">Heritage &amp; Tourism Club</span>
          </div>
        </div>

        <!-- Next Actions -->
        <div class="mt-6 flex flex-wrap items-center gap-3 no-print">
          <button type="button" onclick="window.print()" class="px-5 py-2.5 rounded-lg bg-stone-800 hover:bg-stone-900 text-white text-xs sm:text-sm font-medium flex items-center gap-2 transition active:scale-95 shadow">
            <i data-lucide="printer" class="w-4 h-4"></i> Print / Save Pass (PDF)
          </button>
          <button type="button" id="submitAnotherBtn" class="px-5 py-2.5 rounded-lg border border-stone-300 hover:bg-stone-50 text-stone-700 text-xs sm:text-sm font-medium flex items-center gap-2 transition active:scale-95">
            <i data-lucide="plus-circle" class="w-4 h-4"></i> Submit another response
          </button>
          <a href="https://chat.whatsapp.com/" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-medium flex items-center gap-2 transition active:scale-95 shadow">
            <i data-lucide="message-circle" class="w-4 h-4"></i> Join WhatsApp Group
          </a>
        </div>
      </div>
    </div>

    <!-- Footer Branding -->
    <div class="mt-8 text-center text-xs text-stone-400 space-y-1">
      <p>Heritage &amp; Tourism Club &bull; Explore Gwalior 2026</p>
      <p>This form was created for official event registration and field logistics.</p>
    </div>
  </div>

  <!-- Client-side Logic Script -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // App State
    let currentStep = 1;
    const totalSteps = 4;
    const STORAGE_KEY = 'GWL_HERITAGE_REG_DATA_2026';

    // DOM Elements
    const sections = {
      1: document.getElementById('section-1'),
      2: document.getElementById('section-2'),
      3: document.getElementById('section-3'),
      4: document.getElementById('section-4'),
    };
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const submitBtn = document.getElementById('submitBtn');
    const pageStepLabel = document.getElementById('pageStepLabel');
    const topProgressBar = document.getElementById('topProgressBar');
    const clearFormBtn = document.getElementById('clearFormBtn');
    const heritageForm = document.getElementById('heritageForm');
    const confirmationScreen = document.getElementById('confirmationScreen');
    const submitAnotherBtn = document.getElementById('submitAnotherBtn');

    // College 'Other' input toggle
    const collegeSelect = document.getElementById('college');
    const otherCollegeBox = document.getElementById('otherCollegeBox');
    collegeSelect.addEventListener('change', function() {
      if (this.value === 'Other') {
        otherCollegeBox.classList.remove('hidden');
      } else {
        otherCollegeBox.classList.add('hidden');
      }
    });

    // Helper: Mark field error
    function setError(inputElement, boxId, hasError) {
      const box = document.getElementById(boxId);
      if (!box) return;
      const err = box.querySelector('.error-msg');
      if (hasError) {
        box.classList.add('border-red-400');
        if (err) err.classList.remove('hidden');
        if (inputElement) inputElement.classList.add('border-red-500');
      } else {
        box.classList.remove('border-red-400');
        if (err) err.classList.add('hidden');
        if (inputElement) {
          inputElement.classList.remove('border-red-500');
          inputElement.classList.add('border-stone-300');
        }
      }
    }

    // Validation per section
    function validateSection(step) {
      let isValid = true;

      if (step === 1) {
        // Name
        const nameVal = document.getElementById('fullName').value.trim();
        if (!nameVal || nameVal.length < 2) {
          setError(document.getElementById('fullName'), 'box-fullName', true);
          isValid = false;
        } else {
          setError(document.getElementById('fullName'), 'box-fullName', false);
        }

        // Email regex
        const emailVal = document.getElementById('email').value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailVal || !emailRegex.test(emailVal)) {
          setError(document.getElementById('email'), 'box-email', true);
          isValid = false;
        } else {
          setError(document.getElementById('email'), 'box-email', false);
        }

        // Phone regex (10 digits starting with 6-9)
        const phoneVal = document.getElementById('phone').value.trim();
        const phoneRegex = /^[6-9]\d{9}$/;
        if (!phoneVal || !phoneRegex.test(phoneVal)) {
          setError(document.getElementById('phone'), 'box-phone', true);
          isValid = false;
        } else {
          setError(document.getElementById('phone'), 'box-phone', false);
        }

        // Emergency Contact
        const emergencyVal = document.getElementById('emergencyContact').value.trim();
        if (!emergencyVal || emergencyVal.length < 5) {
          setError(document.getElementById('emergencyContact'), 'box-emergency', true);
          isValid = false;
        } else {
          setError(document.getElementById('emergencyContact'), 'box-emergency', false);
        }
      }

      if (step === 2) {
        // College
        const collegeVal = collegeSelect.value;
        const otherCollegeVal = document.getElementById('otherCollegeName').value.trim();
        if (!collegeVal || (collegeVal === 'Other' && !otherCollegeVal)) {
          setError(collegeSelect, 'box-college', true);
          isValid = false;
        } else {
          setError(collegeSelect, 'box-college', false);
        }

        // Branch
        const branchVal = document.getElementById('branch').value.trim();
        if (!branchVal) {
          setError(document.getElementById('branch'), 'box-branch', true);
          isValid = false;
        } else {
          setError(document.getElementById('branch'), 'box-branch', false);
        }

        // Year / Semester
        const yearVal = document.getElementById('yearSemester').value;
        if (!yearVal) {
          setError(document.getElementById('yearSemester'), 'box-year', true);
          isValid = false;
        } else {
          setError(document.getElementById('yearSemester'), 'box-year', false);
        }

        // Roll Number
        const rollVal = document.getElementById('rollNumber').value.trim();
        if (!rollVal) {
          setError(document.getElementById('rollNumber'), 'box-roll', true);
          isValid = false;
        } else {
          setError(document.getElementById('rollNumber'), 'box-roll', false);
        }
      }

      if (step === 3) {
        // All questions in Section 3 are optional or pre-checked
        isValid = true;
      }

      if (step === 4) {
        // All 3 checkboxes must be checked
        const c1 = document.getElementById('ruleMonument').checked;
        const c2 = document.getElementById('ruleFitness').checked;
        const c3 = document.getElementById('ruleMarshal').checked;
        if (!c1 || !c2 || !c3) {
          setError(null, 'box-undertaking', true);
          isValid = false;
        } else {
          setError(null, 'box-undertaking', false);
        }
      }

      return isValid;
    }

    // Step Rendering
    function updateStepView() {
      // Toggle Section Visibility
      for (let s = 1; s <= totalSteps; s++) {
        if (s === currentStep) {
          sections[s].classList.remove('hidden');
        } else {
          sections[s].classList.add('hidden');
        }
      }

      // Buttons
      if (currentStep === 1) {
        prevBtn.classList.add('hidden');
      } else {
        prevBtn.classList.remove('hidden');
      }

      if (currentStep === totalSteps) {
        nextBtn.classList.add('hidden');
        submitBtn.classList.remove('hidden');
      } else {
        nextBtn.classList.remove('hidden');
        submitBtn.classList.add('hidden');
      }

      // Progress indicators
      pageStepLabel.textContent = `Page ${currentStep} of ${totalSteps}`;
      const progressPercent = (currentStep / totalSteps) * 100;
      topProgressBar.style.width = `${progressPercent}%`;

      // Scroll to form smoothly
      window.scrollTo({ top: 180, behavior: 'smooth' });
      lucide.createIcons();
    }

    // Navigation Listeners
    nextBtn.addEventListener('click', () => {
      if (validateSection(currentStep)) {
        if (currentStep < totalSteps) {
          currentStep++;
          updateStepView();
          saveToLocalStorage();
        }
      }
    });

    prevBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateStepView();
      }
    });

    // Form Submission
    submitBtn.addEventListener('click', () => {
      if (validateSection(4)) {
        const formData = gatherFormData();
        formData.ticketId = 'GWL-HW26-' + Math.floor(1000 + Math.random() * 9000);
        formData.registeredAt = new Date().toISOString();

        // Save submitted registration
        try {
          localStorage.setItem('GWL_SUBMITTED_RECORD', JSON.stringify(formData));
          localStorage.removeItem(STORAGE_KEY);
        } catch (e) {
          console.warn('Storage unavailable', e);
        }

        // Populate Ticket
        document.getElementById('ticketId').textContent = formData.ticketId;
        document.getElementById('ticketName').textContent = formData.fullName;
        document.getElementById('ticketEmail').textContent = formData.email;
        document.getElementById('ticketPhone').textContent = '+91 ' + formData.phone;
        document.getElementById('ticketCollege').textContent = formData.college === 'Other' ? formData.otherCollegeName : formData.college;
        document.getElementById('ticketSize').textContent = formData.tshirt;

        // Switch to Confirmation view
        heritageForm.classList.add('hidden');
        confirmationScreen.classList.remove('hidden');
        topProgressBar.style.width = '100%';
        window.scrollTo({ top: 80, behavior: 'smooth' });
        lucide.createIcons();
      }
    });

    // Submit Another Response
    submitAnotherBtn.addEventListener('click', () => {
      heritageForm.reset();
      currentStep = 1;
      updateStepView();
      confirmationScreen.classList.add('hidden');
      heritageForm.classList.remove('hidden');
      topProgressBar.style.width = '25%';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Clear form
    clearFormBtn.addEventListener('click', () => {
      if (window.confirm("Are you sure you want to clear this form? All entered answers will be reset.")) {
        heritageForm.reset();
        otherCollegeBox.classList.add('hidden');
        localStorage.removeItem(STORAGE_KEY);
        currentStep = 1;
        updateStepView();
      }
    });

    // Gather Form Data Object
    function gatherFormData() {
      const selectedTshirt = document.querySelector('input[name="tshirt"]:checked')?.value || 'Not specified';
      const selectedExp = document.querySelector('input[name="experience"]:checked')?.value || 'No';

      return {
        fullName: document.getElementById('fullName').value.trim(),
        email: document.getElementById('email').value.trim(),
        phone: document.getElementById('phone').value.trim(),
        emergencyContact: document.getElementById('emergencyContact').value.trim(),
        college: document.getElementById('college').value,
        otherCollegeName: document.getElementById('otherCollegeName').value.trim(),
        branch: document.getElementById('branch').value.trim(),
        yearSemester: document.getElementById('yearSemester').value,
        rollNumber: document.getElementById('rollNumber').value.trim(),
        tshirt: selectedTshirt,
        experience: selectedExp,
        medicalNotes: document.getElementById('medicalNotes').value.trim()
      };
    }

    // Save draft responses
    function saveToLocalStorage() {
      try {
        const data = gatherFormData();
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch (e) {
        console.warn('LocalStorage save failed', e);
      }
    }

    // Restore draft responses on initial load
    function restoreDraft() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return;
        const data = JSON.parse(saved);

        if (data.fullName) document.getElementById('fullName').value = data.fullName;
        if (data.email) document.getElementById('email').value = data.email;
        if (data.phone) document.getElementById('phone').value = data.phone;
        if (data.emergencyContact) document.getElementById('emergencyContact').value = data.emergencyContact;
        if (data.college) {
          document.getElementById('college').value = data.college;
          if (data.college === 'Other') {
            otherCollegeBox.classList.remove('hidden');
            document.getElementById('otherCollegeName').value = data.otherCollegeName || '';
          }
        }
        if (data.branch) document.getElementById('branch').value = data.branch;
        if (data.yearSemester) document.getElementById('yearSemester').value = data.yearSemester;
        if (data.rollNumber) document.getElementById('rollNumber').value = data.rollNumber;
        if (data.medicalNotes) document.getElementById('medicalNotes').value = data.medicalNotes;
      } catch (e) {
        console.warn('Draft restoration failed', e);
      }
    }

    // Attach real-time input error clearing
    ['fullName', 'email', 'phone', 'emergencyContact', 'branch', 'rollNumber'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', () => {
          setError(el, 'box-' + (id === 'emergencyContact' ? 'emergency' : id === 'rollNumber' ? 'roll' : id), false);
        });
      }
    });

    ['college', 'yearSemester'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', () => {
          setError(el, 'box-' + (id === 'yearSemester' ? 'year' : id), false);
        });
      }
    });

    // Run on startup
    window.onload = function() {
      restoreDraft();
      updateStepView();
    };
  </script>
</body>
</html>
